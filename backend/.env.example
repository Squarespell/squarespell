# ---------------------------------------------------------------------------
# Added in Phase 1 (names only; values are set in the Render dashboard)
# ---------------------------------------------------------------------------
# The code reads CORE / BUSINESS price-id names (services/billingPlans.ts). The live Stripe catalog currently has
# Starter / Pro / Agency products; mapping them is a Phase 2 decision. A missing price id makes checkout answer 503
# plan_not_configured - it never falls back to another price.
STRIPE_CORE_PRICE_ID=price_...
STRIPE_CORE_YEARLY_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_...
# Optional add-on packs
STRIPE_LEAD_500_PRICE_ID=
STRIPE_LEAD_1500_PRICE_ID=
STRIPE_LEAD_3000_PRICE_ID=
STRIPE_EMAIL_1000_PRICE_ID=
STRIPE_EMAIL_5000_PRICE_ID=
STRIPE_EMAIL_10000_PRICE_ID=
# Optional: dedicated signing secret for /api/webhooks/stripe-quiz-payment (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_QUIZ_PAYMENT_WEBHOOK_SECRET=
# Optional Clerk overrides (networkless JWT verification / API proxy)
CLERK_JWT_KEY=
CLERK_API_URL=
# Optional Anthropic budget (defaults: 40000 ms timeout, 1 retry)
ANTHROPIC_TIMEOUT_MS=
ANTHROPIC_MAX_RETRIES=
