# Squarespell Quiz STAGING environment - NAMES ONLY. No value in this file is a secret.
# On the server this becomes /srv/squarespell-quiz/staging/.env (mode 600, owner squarespell).
#   scripts/gen-env.sh    creates the file and generates the internal secrets (database, JWT, encryption, cron)
#   scripts/set-secret.sh prompts silently for a third-party secret and writes it into the file (nothing echoed)
# Never commit the real file. Never paste values into chat, tickets or logs.

# --- hosts / TLS (non-secret) ---
STAGING_APP_HOST=staging.squarespellquiz.com
STAGING_API_HOST=api-staging.squarespellquiz.com
# NEXT_PUBLIC_SITE_URL is not set here: the staging compose file builds it as https://$STAGING_APP_HOST so a staging build cannot fall back to the production domain.
# One-button connect (optional, staging review only; safe placeholders):
# CONNECT_ENABLED=true
# CONNECT_TEST_FAULTS=true
# CONNECT_MAX_SITES=
# CONNECT_MAX_INSTALLATIONS_PER_SITE=
ACME_EMAIL=

# --- generated on the server by gen-env.sh (internal only) ---
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
PGRST_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
REPORT_SECRET=
CRON_SECRET=

# --- Stripe (existing Squarespell Limited account, TEST MODE only; deploy.sh refuses live keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_PRICE_ID=
STRIPE_CORE_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=

# --- AI provider (dedicated staging key with the smallest practical spend limit; server-side only) ---
ANTHROPIC_API_KEY=

# --- Email: Hostinger SMTP (first-party passwordless email-code auth + all platform email) ---
# SMTP_PASSWORD is a Hostinger app password for info@squarespellquiz.com.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Display name only now (e.g. "Squarespell") -- every outbound email is sent from the one
# authenticated Hostinger mailbox (SMTP_USER), which a plain SMTP account can't override per send.
PLATFORM_EMAIL_FROM=
# Email-sending scheduled jobs stay off unless this is set to true during sandbox testing.
SCHEDULER_ENABLE_EMAIL_JOBS=false

# --- optional ---
ADMIN_EMAILS=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PEXELS_ACCESS_KEY=
UNSPLASH_ACCESS_KEY=
