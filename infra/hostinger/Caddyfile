# Public reverse proxy for STAGING. Caddy obtains and renews HTTPS certificates automatically.
# Hosts and the ACME contact come from the protected server env file (see docker-compose.staging.yml).
{
	email {$ACME_EMAIL}
}

{$STAGING_APP_HOST} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy frontend:3000
}

{$STAGING_API_HOST} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	# Cron endpoints are called only by the internal scheduler/worker; never expose them publicly.
	@cron path /api/cron/*
	respond @cron 404
	reverse_proxy backend:3001
}
