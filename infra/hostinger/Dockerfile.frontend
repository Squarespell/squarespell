# Squarespell Quiz frontend image (Next.js 14). Built from the repository root context.
# NEXT_PUBLIC_* values are public by design and are baked in at build time (API URL, site URL). No secret is needed
# to build: sign-in runs on our own API (no third-party keys).
FROM node:22-bookworm-slim
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SENTRY_DSN=""
# Canonical origin and the search-indexing switch (lib/site.ts). Empty = defaults: production domain, indexing OFF.
ARG NEXT_PUBLIC_SITE_URL=""
ARG NEXT_PUBLIC_ALLOW_INDEXING=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ALLOW_INDEXING=$NEXT_PUBLIC_ALLOW_INDEXING \
    NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
ENV NODE_ENV=production
RUN chown -R node:node /app
USER node
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
