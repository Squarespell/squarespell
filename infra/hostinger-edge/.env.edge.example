# Names only. The real file lives at /opt/squarespell-quiz/edge.env (owner-only). It holds no secrets: hostnames, an ACME contact and switches.
ACME_EMAIL=
PROD_APP_HOST=squarespellquiz.com
PROD_API_HOST=api.squarespellquiz.com
STAGING_APP_HOST=
STAGING_API_HOST=
# Launch gate: true = only GATE_ALLOW_IPS (space separated) reach production; everyone else gets 503. Webhook paths stay reachable.
GATE_ENABLED=true
GATE_ALLOW_IPS=127.0.0.1
# Set to 'on' ONLY at the approved launch, together with GATE_ENABLED=false. Staging is never affected.
PROD_INDEXING=off
