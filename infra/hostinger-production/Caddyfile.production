# PRIVATE production edge: plain HTTP on loopback only (127.0.0.1:18080). No TLS, no admin API, no public exposure.
# At the approved cutover, a public TLS edge forwards the two production hostnames to this listener.
# Hosts come from the protected server env file (PROD_APP_HOST, PROD_API_HOST).
{
	admin off
	auto_https off
}

http://{$PROD_APP_HOST} {
	encode zstd gzip
	# Remove ONLY at the approved launch (this header and the page metadata).
	header X-Robots-Tag "noindex, nofollow"
	# Reproduce frontend/vercel.json (Vercel-only): the /embed.js loader alias and the CORS / framing headers
	# that let customers embed quizzes on their own sites.
	@embedjs path_regexp embedjs "^/embed(\.js|/[^/]+\.js)$"
	header @embedjs Access-Control-Allow-Origin "*"
	header @embedjs Cache-Control "public, max-age=300, s-maxage=60"
	@embedpage path_regexp embedpage "^/embed/[^/.]+$"
	header @embedpage Access-Control-Allow-Origin "*"
	header @embedpage Content-Security-Policy "frame-ancestors *"
	rewrite /embed.js /embed/quiz-embed.js
	reverse_proxy frontend:3000
}

http://{$PROD_API_HOST} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	# Cron endpoints are called only by the internal scheduler/worker; never expose them publicly.
	@cron path /api/cron/*
	respond @cron 404
	reverse_proxy backend:3001
}
