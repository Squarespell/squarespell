# Squarespell Quiz PRODUCTION env - NAMES ONLY. Copy to /opt/squarespell-quiz/production/.env (mode 600, owner squarespell).
# Never commit values. Generate internal secrets on the server; enter provider secrets with scripts/set-secret.sh (hidden prompt).
PROD_APP_HOST=squarespellquiz.com
PROD_API_HOST=api.squarespellquiz.com
# Deliberate live-Stripe safety control: a live Stripe key (sk_live_ / rk_live_) is refused by deploy.sh and set-secret.sh
# unless this is set to the exact value "yes" by the owner. It is a deployment guard only and is not passed to any container.
STRIPE_LIVE_AUTHORISED=
# internal secrets (generated on the server)
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
PGRST_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
REPORT_SECRET=
CRON_SECRET=
# must equal the existing Quiz production key so stored encrypted integration credentials stay readable
ENCRYPTION_KEY=
# Clerk (production instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Stripe (Squarespell Limited account, Quiz products only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_PRICE_ID=
STRIPE_CORE_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
# add-on packs: lead +500 / +1500 / +3000 and email +1000 / +5000 / +10000
STRIPE_LEAD_500_PRICE_ID=
STRIPE_LEAD_1500_PRICE_ID=
STRIPE_LEAD_3000_PRICE_ID=
STRIPE_EMAIL_1000_PRICE_ID=
STRIPE_EMAIL_5000_PRICE_ID=
STRIPE_EMAIL_10000_PRICE_ID=
# AI and email
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
PLATFORM_EMAIL_FROM=
SCHEDULER_ENABLE_EMAIL_JOBS=false
# optional
ADMIN_EMAILS=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PEXELS_ACCESS_KEY=
UNSPLASH_ACCESS_KEY=
