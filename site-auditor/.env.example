# ---------------------------------------------------------------- required
# Supabase (project: squarespell-us). The service-role key is server-only and
# must never be exposed to the browser.
SUPABASE_URL=https://ibipglxzqowuipepmlnp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing requester IPs. Any long random string. Changing it resets
# all rate-limit buckets.
HASH_SALT=

# ---------------------------------------------------------------- optional
# Without a key the report still renders in full using deterministic
# explanations — the AI layer only adds narrative on top of measured findings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google PageSpeed Insights. Without a key the "Real speed" section falls back
# to the shared anonymous quota, which is usually exhausted, so the section will
# mostly say Google is rate limiting us. A free key from the Google Cloud
# console (enable the PageSpeed Insights API) removes that entirely.
PAGESPEED_API_KEY=

# Emailing the PDF report. Without these the report is still downloadable from
# the button in the report header, and the lead is still captured; the UI simply
# offers the download instead of claiming an email was sent.
RESEND_API_KEY=
EMAIL_FROM=Squarespell <audit@squarespell.com>
EMAIL_REPLY_TO=info@squarespell.com

# Abuse limits (per hashed requester)
RATE_LIMIT_BURST=3
RATE_LIMIT_DAILY=15

# Public URLs used in the UI
NEXT_PUBLIC_SITE_URL=https://auditor.squarespell.com
NEXT_PUBLIC_BRAND_URL=https://squarespell.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/squarespell-info/30min
NEXT_PUBLIC_SERVICES_URL=https://squarespell.com/squarespace-website-design
